ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://cms_owner:cms_owner@127.0.0.1:5434/cms
RUNTIME_DATABASE_URL=postgresql+psycopg://cms_runtime:cms_runtime@127.0.0.1:5434/cms
SECRET_KEY=replace-with-a-random-development-secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
